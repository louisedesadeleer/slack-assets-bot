SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Comma-separated Slack user IDs allowed to use the bot. Anyone else
# gets a polite refusal that includes their user ID. Leave empty on
# first run — DM the bot and it'll reply with your user ID.
ALLOWED_SLACK_USERS=

# Set to 'true' to let anyone in your Slack workspace use the bot.
# NOT recommended unless you're the only one in the workspace.
ALLOW_WORKSPACE=

# Where to save assets on this machine.
ASSETS_DIR=~/assets

# Folders to create inside ASSETS_DIR. The bot only writes to enabled
# categories. Options: screenshots, photos, videos, sounds, memes, thumbnails.
CATEGORIES=screenshots,photos,videos,sounds

# Auto-rename images using Claude vision. Generic-looking filenames
# (CleanShot, Screenshot, IMG_, image_001 ...) get rewritten to a short
# descriptive slug like 'kanye_west_laughing.png' so an AI assistant
# can find them later by name. Only runs when the `claude` CLI is on PATH.
AUTO_NAME_IMAGES=true
